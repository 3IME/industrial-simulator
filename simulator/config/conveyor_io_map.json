{
  "version": 1,
  "description": "Mapping PLC <-> simulation du prototype convoyeur (Phase 0)",
  "mappings": [
    { "address": "%IX0.0", "variable": "sensor_entry" },
    { "address": "%IX0.1", "variable": "sensor_exit" },
    { "address": "%IX1.0", "variable": "conveyor_01.running" },
    { "address": "%IW0", "variable": "conveyor_01.speed" },
    { "address": "%IW1", "variable": "conveyor_01.position" },
    { "address": "%QX0.0", "variable": "conveyor_01.run" },
    { "address": "%QX0.1", "variable": "conveyor_01.stop" },
    { "address": "%QW0", "variable": "conveyor_01.speed_command" }
  ]
}
